{
    "name": "editable-list/app",
    "description": "Editable list: a small Yii 2 application with a REST API and same-origin real-time updates",
    "type": "project",
    "license": "BSD-3-Clause",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "~8.4.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "workerman/redis": "^2.0.6",
        "workerman/workerman": "^5.2.2",
        "yiisoft/yii2": "~2.0.55",
        "yiisoft/yii2-redis": "~2.1.2"
    },
    "replace": {
        "bower-asset/inputmask": "*",
        "bower-asset/jquery": "*",
        "bower-asset/punycode": "*",
        "bower-asset/yii2-pjax": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "symfony/yaml": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "app\\": ""
        },
        "exclude-from-classmap": [
            "/tests/",
            "/migrations/"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse --no-progress",
        "style": "php-cs-fixer check --diff",
        "style:fix": "php-cs-fixer fix"
    },
    "scripts-descriptions": {
        "test": "Run every backend test suite (unit, integration/contract, legacy parity)",
        "analyse": "Run PHPStan static analysis",
        "style": "Check coding style without modifying files"
    }
}
