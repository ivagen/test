#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Yii console entry script.
 *
 * Debug follows APP_ENV, so a production container never runs the console with verbose
 * error output either.
 */

require __DIR__ . '/vendor/autoload.php';

defined('YII_ENV') or define('YII_ENV', app\components\Environment::isProduction() ? 'prod' : 'dev');
defined('YII_DEBUG') or define('YII_DEBUG', YII_ENV !== 'prod');

require __DIR__ . '/vendor/yiisoft/yii2/Yii.php';

$config = require __DIR__ . '/config/console.php';

exit((new yii\console\Application($config))->run());
