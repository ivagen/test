# Copy to .env before the first start:  cp .env.example .env
#
# Every value here is a NON-SECRET local development default. Nothing in this file is used
# as-is in production: APP_ENV=prod makes the application refuse to boot while any
# placeholder secret below is still in place (see www/config/env.php).

# ---------------------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------------------

# dev | prod. Controls debug output, error verbosity and secret validation.
APP_ENV=dev

# The ONLY port published to the host. Change it if 8080 is already occupied.
APP_PORT=8080

# Signs cookies and the CSRF token. The value below is a well-known development
# placeholder; APP_ENV=prod rejects it. Generate a real one with:
#   openssl rand -base64 32
APP_COOKIE_VALIDATION_KEY=dev-only-insecure-placeholder-change-me

# ---------------------------------------------------------------------------------------
# PostgreSQL (source of truth; never published to the host)
# ---------------------------------------------------------------------------------------

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=dev-only-insecure-placeholder-change-me
DB_HOST=postgres
DB_PORT=5432

# ---------------------------------------------------------------------------------------
# Redis (transient real-time fan-out only; never a source of truth, never published)
# ---------------------------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------------------
# Real-time worker (internal only; the browser reaches it through the proxy at /ws)
# ---------------------------------------------------------------------------------------

REALTIME_CHANNEL=items.events
REALTIME_WS_PORT=8080
REALTIME_HEALTH_PORT=8081

# ---------------------------------------------------------------------------------------
# End-to-end tests
# ---------------------------------------------------------------------------------------

# How Playwright reaches the app from inside the frontend container.
E2E_BASE_URL=http://nginx
